FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://internagent_runtime:REPLACE_ME@HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@HOST:5432/postgres?sslmode=require
GROQ_API_KEY=
GROQ_MODEL=

# AI usage is limited per user and workspace over a rolling hour.
AI_REQUESTS_PER_HOUR=30
# Optional prices for the configured GROQ_MODEL in USD per million tokens.
# GROQ_INPUT_USD_PER_MILLION=
# GROQ_OUTPUT_USD_PER_MILLION=

# Jira Cloud (test site). The token stays server-side.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=FLEET
